---
// Self-hosted so the masthead does not wait on a third-party font request.
// Subsets are split by unicode-range, so only the latin woff2 is fetched.
import '@fontsource-variable/jetbrains-mono/wght.css';

interface Props {
  title: string;
  /**
   * Hold the masthead hidden until the console finishes booting, then fade
   * it in. Only the home page has a console; everywhere else it paints with
   * the HTML.
   */
  deferTitle?: boolean;
}

const { title, deferTitle = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kyle Sullivan</title>
  </head>
  <body>
    <p class:list={['site-title', { 'is-deferred': deferTitle }]}>
      <a href="/">kyle sullivan</a>
    </p>
    <main>
      <slot />
    </main>
    <script is:inline>
      // Inline and immediate so it is listening before the console island
      // loads -- the boot-complete action does not replay. No-ops on pages
      // whose title is not deferred.
      (function () {
        var el = document.querySelector('.site-title.is-deferred');
        if (!el) return;

        var shown = false;
        function show() {
          if (shown) return;
          shown = true;
          el.classList.add('is-visible');
        }

        function handleBoot(event) {
          if (event.detail?.type !== 'boot-complete') return;
          window.removeEventListener('gbc:action', handleBoot);
          // A beat after the menu's first frame, including a skipped boot.
          window.setTimeout(show, 1000);
        }
        window.addEventListener('gbc:action', handleBoot);

        // Failsafe: without WebGL boot-complete never fires, and the title
        // would stay invisible forever.
        window.setTimeout(show, 12000);
      })();
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    line-height: 1.6;
  }
  /* ---- Masthead ---- */
  .site-title {
    margin: 0 0 1.5rem;
    text-align: center;
    font-family: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo,
      monospace;
    font-size: clamp(1.5rem, 6vw, 2rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .site-title a {
    color: inherit;
    text-decoration: none;
  }
  /* Deferred until the console boots. Only opacity animates, so the box is
     laid out from the first paint and nothing shifts when it appears. */
  .site-title.is-deferred {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .site-title.is-deferred.is-visible {
    opacity: 1;
  }

  /* ---- Home: 3D console stage ---- */
  .home {
    /* Break out of the 40rem body column so the console has room. */
    width: min(92vw, 60rem);
    margin-left: calc(50% - min(46vw, 30rem));
    display: flex;
    flex-direction: column;
    align-items: center;

    /*
      Everything the stage has to share the screen with: the body's padding,
      the masthead and its margin, and the readout. The spin handle hangs
      below the stage rather than sitting in flow, so its overhang is counted
      here too -- otherwise it is the first thing off the bottom.
    */
    --gbc-chrome: 8.5rem;
    /*
      svh, not vh: on a phone vh is the *large* viewport, measured as if the
      URL bar were hidden. The page does not scroll, so anything budgeted
      against vh while the bar is actually showing is simply unreachable --
      which is how the spin handle ended up under the browser chrome.

      The floor keeps the console usable on short landscape phones, where
      subtracting the chrome from the viewport leaves almost nothing; there
      the page scrolls instead.
    */
    --gbc-stage-height: max(18rem, min(calc(100svh - var(--gbc-chrome)), 680px));
  }
  .home-console {
    position: relative;
    /* Reserves the stage height up front so the loader fills a stable box
       and the canvas drops straight in without shifting the page. */
    width: 100%;
    min-height: var(--gbc-stage-height);
  }
  .gbc-stage {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    /* Keeps the WebGL canvas from eating page scroll on touch. */
    touch-action: pan-y;
  }
  .gbc-stage canvas {
    display: block;
    /* The canvas takes the stage height; the hint sits under it. */
    flex: 1 1 auto;
    min-height: 0;
    outline: none;
    /* Draggable to rotate; Console swaps in 'grabbing' mid-drag. */
    cursor: grab;
    /* A drag crossing the canvas edge must not select page text. */
    user-select: none;
    -webkit-user-select: none;
  }
  /* On touch the console does not rotate from the canvas -- the spin handle
     owns that -- so a finger here should scroll the page normally in both
     axes rather than being constrained to pan-y. */
  @media (hover: none) and (pointer: coarse) {
    .gbc-stage {
      touch-action: auto;
    }
    .gbc-stage canvas {
      touch-action: auto;
      cursor: default;
    }
  }
  .gbc-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .gbc-hint {
    margin: 0;
    text-align: center;
    font-size: 0.8rem;
    color: #8a8a93;
    opacity: 0;
    transition: opacity 0.6s ease 0.2s;
  }
  .gbc-hint.is-visible {
    opacity: 1;
  }

  /* ---- Touch-only hold-to-spin handle ---- */
  .gbc-spin-handle {
    position: absolute;
    /* Sits clear of the console's left edge rather than straddling it --
       the mark is solid black and loses contrast over the red shell. */
    left: 2.0rem;
    /* Sits low in the stage, below the console's bottom edge. */
    bottom: -2.05rem;
    z-index: 3;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Bare icon, but the tap target stays at the 44px minimum. */
    width: 44px;
    height: 44px;
    padding: 0;

    color: #111;
    background: none;
    border: none;
    appearance: none;
    -webkit-appearance: none;

    /* The whole point of the control: the browser must not claim the drag
       for scrolling, or the handle only works until the finger moves. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;

    opacity: 0;
    transition: opacity 0.4s ease 0.1s, transform 0.12s ease;
  }
  /* Only usable once the intro has finished, so it fades in with the hint. */
  .gbc-spin-handle.is-visible {
    opacity: 1;
  }
  /* No fill or border to light up, so the press reads through scale alone. */
  .gbc-spin-handle:active {
    transform: scale(0.92);
    cursor: grabbing;
  }
  .gbc-spin-handle svg {
    /* Smaller than the 44px target: the glyph is the visual, the rest is
       invisible touch margin. The orbit geometry is derived against this
       size -- see the comment on the mark -- so changing it needs the ring
       and body re-checked, not just a new number here. */
    width: 30px;
    height: 30px;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .gbc-spin-handle {
      transition: none;
    }
    /* Still gated on the boot sequence, but it cuts in rather than fading. */
    .site-title.is-deferred {
      transition: none;
    }
  }
  .home-readout {
    min-height: 1.5rem;
    margin: 0.25rem 0 0;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: #c8103c;
  }
  /* ---- Home: desktop side panel ---- */
  /* Closed panels are kept out of layout entirely below the desktop
     breakpoint; on phones the menu navigates to the standalone pages. */
  .home-panel {
    display: none;
  }
  /* Keep in sync with PANEL_QUERY in HomeConsole. */
  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    .home {
      /* On desktop the canvas can grow with the available height; the
         phone-sized 680px ceiling leaves a small console on tall monitors. */
      --gbc-stage-height: max(18rem, calc(100svh - var(--gbc-chrome)));
    }
    .home-console {
      /* Size the camera's frame to the space it can actually occupy when a
         panel opens. Keep this width in both states so sliding the console
         does not resize the canvas or change its scale mid-transition. */
      width: 50vw;
      flex: none;
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    /* Slides the console's centre from the middle of the viewport to the
       middle of its left half, leaving the right half to the panel. */
    .home[data-panel] .home-console {
      transform: translateX(-25vw);
    }
    .home-panel {
      display: block;
      position: fixed;
      /* Starts below the masthead so the title stays clickable. */
      top: 4.5rem;
      right: 0;
      bottom: 0;
      width: 50vw;
      z-index: 4;
      box-sizing: border-box;
      padding: 0 max(2rem, 4vw) 2rem;
      overflow-y: auto;
      overscroll-behavior: contain;

      opacity: 0;
      visibility: hidden;
      transform: translateX(3rem);
      /* Visibility waits for the fade so the panel stays painted while it
         leaves, then drops out of hit-testing. */
      transition: opacity 0.35s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.6s;
    }
    .home-panel.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.45s ease 0.15s,
        transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s, visibility 0s;
    }
  }
  .home-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .home-panel-header h1 {
    margin: 0;
    font-family: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo,
      monospace;
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .home-panel-close {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    font-size: 1.5rem;
    line-height: 1;
    color: #111;
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }
  .home-panel-close:hover,
  .home-panel-close:focus-visible {
    background: #f0f0f2;
  }
  @media (prefers-reduced-motion: reduce) {
    .home-console,
    .home-panel,
    .home-panel.is-open {
      transition: none;
    }
  }

  .home-copy {
    max-width: 34rem;
    text-align: center;
  }
  .home-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
</style>
