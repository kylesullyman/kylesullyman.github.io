---
import Nav from '../components/Nav';

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kyle Sullivan</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    line-height: 1.6;
  }
  .dots-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .dots-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 3rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid #ccc;
    border-radius: 999px;
    background: #fff;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #333;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .dots-links {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .dots-links li {
    opacity: 0;
    transform: translateX(-0.75rem);
    transition: opacity 0.25s ease, transform 0.25s ease;
    transition-delay: calc((2 - var(--i)) * 50ms);
  }
  .dots-links a {
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }
  .dots-links a:hover,
  .dots-links a:focus-visible {
    border-color: currentColor;
  }

  /* Open on hover, or on keyboard/tap focus */
  .dots-nav:hover .dots-toggle,
  .dots-nav:focus-within .dots-toggle {
    background: #333;
    border-color: #333;
    transform: scale(1.08);
  }
  .dots-nav:hover .dot,
  .dots-nav:focus-within .dot {
    background: #fff;
    animation: dot-bounce 0.6s ease infinite alternate;
  }
  .dots-nav:hover .dot:nth-child(2),
  .dots-nav:focus-within .dot:nth-child(2) {
    animation-delay: 0.15s;
  }
  .dots-nav:hover .dot:nth-child(3),
  .dots-nav:focus-within .dot:nth-child(3) {
    animation-delay: 0.3s;
  }
  .dots-nav:hover .dots-links,
  .dots-nav:focus-within .dots-links {
    pointer-events: auto;
  }
  .dots-nav:hover .dots-links li,
  .dots-nav:focus-within .dots-links li {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(var(--i) * 70ms);
  }

  @keyframes dot-bounce {
    to {
      transform: translateY(-4px) scale(1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dots-toggle,
    .dot,
    .dots-links li {
      transition: none;
      animation: none !important;
    }
  }
</style>
